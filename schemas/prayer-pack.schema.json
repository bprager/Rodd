{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rodd.local/schemas/prayer-pack.schema.json",
  "title": "Rǫdd prayer pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packVersion",
    "contractId",
    "work",
    "profile",
    "sourceWitness",
    "referenceAudio",
    "sources",
    "rules",
    "normalizationDecisions",
    "lexicon",
    "lines"
  ],
  "properties": {
    "packVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contractId": {"type": "string", "minLength": 1},
    "work": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "period", "region", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sourceWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shelfmark", "workLocation", "note"],
      "properties": {
        "shelfmark": {"type": "string", "minLength": 1},
        "workLocation": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "referenceAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "analysis", "attribution", "styles", "tempos"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "analysis": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["precise", "naturalized"],
          "properties": {
            "precise": {"$ref": "#/$defs/referenceLabel"},
            "naturalized": {"$ref": "#/$defs/referenceLabel"}
          }
        },
        "tempos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["natural", "teaching"],
          "properties": {
            "natural": {"$ref": "#/$defs/tempoLabel"},
            "teaching": {"$ref": "#/$defs/tempoLabel"}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "normalizationDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/normalizationDecision"}
    },
    "lexicon": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lexeme"}
    },
    "lines": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/line"}
    }
  },
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "referenceLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "purpose", "limitation"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "limitation": {"type": "string", "minLength": 1}
      }
    },
    "tempoLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "purpose"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "citation", "url", "accessed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["manuscript-edition", "critical-edition", "academic-grammar", "university-course"]},
        "citation": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator", "position"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "position": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "statement", "confidence", "scorable", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["profile", "text", "vowel", "diphthong", "consonant", "quantity", "stress", "prosody"]},
        "statement": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "scorable": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "note": {"type": "string"}
      }
    },
    "normalizationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selected", "alternatives", "rationale", "sourceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selected": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "syllable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipa", "stress"],
      "properties": {
        "ipa": {"type": "string", "minLength": 1},
        "stress": {"enum": ["primary", "secondary", "unstressed"]}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipa", "reason", "sourceIds"],
      "properties": {
        "ipa": {"type": "string", "pattern": "^/.+/$"},
        "reason": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "quantityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment", "kind"],
      "properties": {
        "segment": {"type": "string", "minLength": 1},
        "kind": {"enum": ["long-vowel", "geminate", "diphthong"]}
      }
    },
    "lexeme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "normalized",
        "canonicalIpa",
        "syllables",
        "acceptedVariants",
        "confidence",
        "quantityTargets",
        "ruleIds",
        "sourceIds",
        "teachingNotes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1},
        "canonicalIpa": {"type": "string", "pattern": "^/.+/$"},
        "syllables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/syllable"}},
        "acceptedVariants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "quantityTargets": {"type": "array", "items": {"$ref": "#/$defs/quantityTarget"}},
        "ruleIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sourceIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "teachingNotes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "stanza", "editionText", "normalizedText", "tokenIds", "sourceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1, "maximum": 8},
        "stanza": {"type": "integer", "enum": [3, 4]},
        "editionText": {"type": "string", "minLength": 1},
        "normalizedText": {"type": "string", "minLength": 1},
        "tokenIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sourceIds": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    }
  }
}
